# =========================================================================
# azure — reference image 6 ("azure calm console"), the same layout as
# reference images 2, 3 and 4 in a fourth hue.
#
# THIS THEME IS A CONSOLE WITH NOTHING WRONG. Every other family-A theme is
# a screen mid-incident: image 4 is all red, image 5 is locked down, images
# 1-3 carry `KRYTYCZNY ALARM` across the top bar. Image 6's bar reads only
# an ordinary status line rather than an alarm, and its text is the accent
# rather than a warning colour. So azure is not "the blue one" — it is the
# nominal state of the same instrument: one blue (#29B6F6) with a lighter
# blue (#4FC3F7) for highlights, thinner glows than any other console
# theme, a starfield instead of PCB traces, and no vignette, so the empty
# space between panels reads as depth rather than as a dark frame.
#
# Everything below is FIVE seeds and six deviations. The interface is not
# re-coloured here; the seeds are, and the master re-derives it. Two things
# the identity calls for that are therefore ABSENT from this file:
#   * the `CREW STATUS` vitality glyphs. Image 6 replaces the `CRITICAL`
#     badges of images 1-3 with rows of small cyan hearts; `icon.heart` is
#     already declared in the master, already drawn at `@icon.color` ->
#     `@accent.primary`, and `@accent.primary` is now blue. Which of the
#     two the widget draws is the widget's state, not the theme's, and the
#     colour needs no line here.
#   * `severity.critical`. Mode `hue` pulls the canonical red toward the
#     accent and the master's 7deg clamp (m3 M6) stops it at #FF5160 — the
#     rose-red the brief names. The old 14deg clamp produced #FE4F73, a
#     pink; with the tighter clamp no override is needed.
# =========================================================================

[meta]
schema          = 1
name            = "Azure"
name[pl]        = "Lazur"
description     = "Calm blue console with nothing wrong. Reference image 6."
description[pl] = "Spokojna niebieska konsola bez alarmu. Obraz referencyjny 6."
author          = "nacelle"
family          = console
base            = "default"


# ---------------------------------------------------------------- palette
# The five seeds. `data` is deliberately not written: image 6's starfield,
# orbital paths and charts are the same blue as its borders, so `data`
# stays at its default of `@palette.accent` and chrome and data move
# together. Separating them is image 5's job, not this one.
[palette]
black      = #050A10   # shade() target — the blue-black image 6 sits on; literal by rule (5.2)
white      = #E8F3FB   # tint() target — a cool white; the mint master's #EAF6F1 tints highlights green
accent     = #29B6F6   # THE seed. Borders, titles, glyphs, charts, cursor, the vitality hearts
accent_alt = #4FC3F7   # image 6's stated highlight. Kept only because [accent] hover pins the same
                       # value below; if the engine ever grows more accent.secondary consumers this
                       # seed is already correct (m3 §4.6)
neutral    = #75818C   # hue-free grey anchor for offline/disabled, leaned cool


# ---------------------------------------------------------------- surface
# THE correction (m3 §4.6). Image 6 is "calmer: more empty space reading as
# depth" — the empty space IS the theme, and at the master's C 0.0175 it is
# a neutral dark grey.
[surface]
chroma = 1.8           # composited panel -> #081A24 (C 0.0307), a field that is visibly
                       # blue without ever becoming a wash
lift   = -0.015        # one small step down so the starfield reads against it


# ---------------------------------------------------------------- border
# The one theme that leans the panel ring SOFTER than the master's 0.78:
# image 6 is the calm one and its edge is lit, not alarmed. 5.81:1 on the
# composited panel (m3 §5.2).
[border]
default = alpha(@accent.primary, 0.72)


# ---------------------------------------------------------------- density
# "More empty space reading as depth" is a spacing decision, and the master
# already has the knob: image 1 is `compact`, image 6 is `airy` (5.3). But
# density is geometry, and switching themes must never rearrange a widget's
# interior (11.08): every shipped theme keeps the master's `compact`, so a
# theme switch changes colour and light, never layout.


# ---------------------------------------------------------------- accent
# The master derives hover as tint(accent, 0.18), which against this
# theme's cool white lands on #5CC1F8 — near-identical, and near-identical
# is not the same as named. Image 6 names its highlight, so the theme says
# it. 8.86:1 on the composited panel (m3 §4.6).
[accent]
hover = #4FC3F7


# ---------------------------------------------------------------- glow
# Family A's signature is a 1 px edge that is LIT, and the master ships
# every glow class off (a silent theme renders flat and cheap). Azure has
# to switch two of them on, and the whole identity is in how little it asks
# for: image 6 is "calmer: thinner glows". Radius stays under the 0.85u
# threshold at which `mode = auto` picks the cheap shell technique instead
# of a sprite, so the calm reading and the cheap path are the same choice.
[glow]
panel_edge.enabled = true
panel_edge.radius  = 0.6u    # image 1's bloom reaches past a panel; image 6's barely leaves the line
panel_edge.alpha   = 0.16    # low enough that the edge reads as lit, never as a second border

text_display.enabled = true
text_display.radius  = 0.85u # the big clock is the one element image 6 still lets bloom
text_display.alpha   = 0.14


# ---------------------------------------------------------------- topbar
# Image 6's centre cluster is `SYSTEM STATUS` and nothing else. The master
# lets the alarm half pulse and it is the master's own comment that names
# image 6 as the theme which turns it off: with `pulse = false` the centre
# cluster stops blinking and stays the ordinary accent. This is the single
# line that separates a calm console from an alarmed one.
[topbar]
alarm.pulse = false


# ---------------------------------------------------------------- decor
# "A starfield with orbital paths" where images 1 and 4 have PCB traces,
# and no vignette at all — image 4's heavy corners would close the empty
# space this theme spends. `traces`, `vignette`, `scanlines`, `noise` and
# `ribbons` are all off in the master and stay off; only the starfield is
# named, and it is baked once into the backdrop plate, so it costs one
# quad per frame.
#
# `backdrop.source` has to move with it: a baked decoration layer only
# reaches the screen through the plate (5.15), and the plate's default
# layer order already draws the starfield.
[backdrop]
source = plate

[decor]
enabled = true

[decor.starfield]
enabled  = true
count    = 520      # a fuller sky than the master's 400; baked once, so the count is free per frame
seed     = 6        # pinned to the reference image number, so azure's sky never moves between builds
size_max = 0.24u    # the master's 0.28u near-stars read as dust specks against a calm field
