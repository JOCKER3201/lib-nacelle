# nacelle theme — spring

[meta]
schema          = 1
name            = "Spring"
name[pl]        = "Wiosna"
description     = "Near-monochrome spring green on black. Reference image 2."
description[pl] = "Niemal monochromatyczna wiosenna zieleń na czerni. Obraz referencyjny 2."
author          = "nacelle"
family          = console
base            = "default"


# =========================================================================
# WHAT THIS THEME IS — reference image 2 ("Aurora / spring-green console").
#
# Image 2 is image 1's layout with the hue moved off mint and the secondary
# colours taken away: one spring green does the borders, the titles, the
# hexagons, the ANALYTICS FEED line, the CREW STATUS badges and the clock,
# over a background so dark it reads as black. There is no cyan beside it
# and no second chrome hue worth naming — what gives the screen its depth
# is not a second colour but the BLOOM, the glow that in image 2 spills off
# the monitor and lights the concrete wall behind it.
#
# So this file is the cascade's proof: ONE accent hex re-skins the whole
# interface (5.2), plus the two-scalar drop that puts the field on image 2's
# black, and "let it glow". palette.data and palette.accent_alt are
# deliberately NOT written — data follows the accent because image 2's
# station wireframe and its plots are the same green as its borders, and
# accent_alt defaults to hue(accent, 32), reaches one symlink glyph, and
# image 2 has no second hue to spend a line on (m3 §4.2). Every surface,
# text role, border, severity colour, terminal slot and component colour
# below the palette is inherited and re-derived (4.1).
# =========================================================================


# ---------------------------------------------------------------- palette
[palette]
accent  = #4FE07A
                    # THE hex. Image 2's spring green: borders, titles,
                    # hexagons, the ANALYTICS FEED line, the CREW STATUS
                    # badges, the 21:52:12 clock. Everything else in the
                    # theme is a derivation of this value.
black   = #060B07
                    # shade() target, pulled darker than aurora's #0A100E so
                    # severity badge pills and the vignette floor sit on
                    # image 2's blacker field. Literal by rule (5.2)
white   = #E8F6EC
                    # tint() target. Literal by rule (5.2)
neutral = #6B7A70
                    # hue-free grey anchor for offline / disabled


# ---------------------------------------------------------------- surface
# Image 2: the field is "so dark it reads as black", a step under image 1's
# #141E1A. The two scalars below are the whole correction (m3 §4.2).
[surface]
lift   = -0.030     # composited panel goes #141F16 -> #0C180F (L 0.224 -> 0.194)
chroma = 1.15       # near-monochrome means the field itself must carry the
                    # hue; the master's C 0.0228 at panel is under the
                    # visible-tint threshold, 1.15x puts it at 0.0254 without
                    # ever reading as a green wash


# ---------------------------------------------------------------- text
[text]
chroma = 1.5        # image 2 is one green doing the titles, the values, the
                    # axis labels and the badges. At 1.0 text.title is
                    # #A3E8B0, a pastel; at 1.5 it is #78E693, which is the
                    # accent's family
lift   = -0.030     # the ladder drops with the bed so the readouts stay a
                    # lit green rather than a white that happens to sit on
                    # green


# ---------------------------------------------------------------- glow
# The one deviation that is not a hue. `default` ships every glow class
# disabled, because a silent theme must render flat and cheap (8). Image 2
# cannot: with the secondary colours gone, the bloom IS the depth — the
# panel edges are lit rather than drawn, and the monitor throws green onto
# the wall behind it. Three classes carry that, and no more; each is opted
# in with a radius and an alpha, since radius 0u / alpha 0.0 are the
# master's "draw nothing" sentinels (5.13). The colour input stays
# `element`, so every glow is the glowing thing's own resolved colour and
# re-skins with the accent like everything else.
[glow]
panel_edge.enabled  = true
                    # the 1px panel border, family A's signature, and the
                    # single largest source of the bloom in image 2
panel_edge.radius   = 1.1u
                    # ~6px @1440p — past the `auto` mode's 0.85u shell
                    # threshold, so it resolves to a sprite halo rather than
                    # a one-quad shell; that is what a soft spill needs
panel_edge.alpha    = 0.30
                    # matches accent.glow's own 0.30 — lit, not smeared

text_display.enabled = true
                    # the big clock. Image 2 reads `21:52:12` as a light
                    # source in its own box, not as text on a panel
text_display.radius  = 1.6u
                    # wider than the panel edge: a numeral is a small shape
                    # and needs more reach before the halo is visible
text_display.alpha   = 0.34

text_alert.enabled  = true
                    # `ALERT: SECURITY PROTOCOL ACTIVATED` in the top bar.
                    # Image 1 colours its alarm half amber; image 2 keeps
                    # the alarm in the theme's own green and separates it
                    # from the product name by BRIGHTNESS — so the alarm
                    # line has to glow or it is just more small caps
text_alert.radius   = 1.2u
text_alert.alpha    = 0.40
                    # the loudest of the three; this is the one string on
                    # screen that must be seen from across the room
