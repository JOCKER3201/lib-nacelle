[meta]
schema          = 1
name            = "Instrument"
name[pl]        = "Przyrząd"
description     = "Flat navy instrument deck, bright cyan outlines. Reference images 8 and 9."
description[pl] = "Płaski granatowy pulpit przyrządowy, jasne cyjanowe obrysy. Obrazy referencyjne 8 i 9."
author          = "nacelle"
family          = holographic
base            = "default"

# =========================================================================
# INSTRUMENT — reference images 8 and 9.
#
# This is family B with the hologram taken out of it. Image 9 is a wide FLAT
# screen: a deep navy plate carrying a measuring grid, one main pane outlined
# in bright cyan, columns of hexadecimal dump filling both outer margins,
# donut gauges at the right edge, and the most elaborate taskbar in the whole
# brief — large bordered buttons with a glyph above a caption, paging
# chevrons, and two more gauges. Image 8 supplies the same card column and
# the orange active HOME icon.
#
# So it is the anti-cockpit: glass is kept, because the panes still sit over
# a plate rather than in it, but pinned at the softest rank on every level;
# depth is spent on one short shadow instead of a halo; and everything the
# cockpit spends on atmosphere this theme spends on density instead. The
# plate is NAVY and the edge is CYAN — the one place this theme refuses the
# master's "surfaces take the accent's hue", and the reason the surface
# ladder below is written out.
# =========================================================================


# ---------------------------------------------------------------- palette
# The seeds. Everything not named further down derives from these five.
[palette]
black   = #04070E      # shade() target; navy-black, not the master's green-black · MUST be a literal
white   = #E8F1FA      # tint() target; the cool near-white image 9's readouts sit at · MUST be a literal
accent  = #23C9E8      # the bright cyan the main pane and every panel edge is outlined in
neutral = #6E7A8C      # hue-free anchor for offline / disabled, leaned navy so it belongs to the plate
# palette.data is deliberately NOT set: image 9's plots, gauge arcs and donut
# sweeps are the same cyan as its chrome. Unlike image 5 there is nothing to
# separate, so `data` keeps following the accent and costs this theme no line.


# ---------------------------------------------------------------- the plate
# The one structural deviation. The master derives all six surface levels
# from the accent's hue, which for a cyan seed lands the background on a
# dark teal. Image 9's background is unmistakably NAVY, a hue apart from
# its own cyan edge, and that separation is what makes the edge read as
# *lit* rather than as a lighter shade of the plate.
#
# Was six longhand oklch() lines; these three scalars reproduce that ladder
# to within 1/255, and the tie to @chroma.accent survives so a re-seeded
# accent still moves the plate (m3 M1-M3, §4.8).
[surface]
hue    = 265           # image 9's background is unmistakably NAVY (#060B18), a hue apart
                       # from its own cyan edge
lift   = -0.026        # a flat screen has no wallpaper behind it to darken the frame, so
                       # the frame has to be darker itself. Puts base exactly on #060B18
chroma = 2.28          # image 9's navy is C 0.0295; the master derives 0.0129 for this
                       # accent


# ---------------------------------------------------------------- text
# Six of the seven roles keep deriving from the accent and land correctly on
# the navy plate. Only `primary` is pinned: the value half of every readout
# in image 9, and the big clock, are a colder near-white than the cyan lean
# gives, and this role is one of the theme's stated five.
[text]
primary = oklch(0.9166, 0.18x@chroma.accent, 240)              # #D6E6F2 · 14.26:1 on the composited panel, floor 7.0 (m3 §4.8)

# The 1px edge. "The main pane outlined in BRIGHT cyan" — the loudest thing
# on the plate. Was 0.80 against a master default of 0.55; against the
# master's new 0.78 default (m3 M5) this line stays, because image 9 is the
# one screen that wants the edge nearly solid. 8.36:1.
[border]
default = @accent.primary / 0.90


# severity.critical.text is deliberately NOT pinned any more (m3 §4.8): the
# reason the pin existed (red dragged toward cyan arrived pink) is fixed for
# everyone by the master's 7deg pull_clamp, and the derivation now lands on
# #FF5160 — dE 0.035 from the old #FF5A48 pin.


# ---------------------------------------------------------------- density
# "The densest typography in the set: many sizes, from a 3-4px-equivalent
# data dump to the large clock." That ladder is not authored here — it is
# already in the master's twenty-four type roles. Image 9 sits at the
# `instrument` level (0.72 spacing / 0.90 type), but density is geometry,
# and switching themes must never rearrange a widget's interior (11.08):
# every shipped theme keeps the master's `compact`, so a theme switch
# changes colour and light, never layout.


# ---------------------------------------------------------------- material
# Glass survives, pinned at rank 1 on every level that may wear it. Rank 1 is
# the cheapest non-zero frost: it separates a card from the grid behind it
# without the cockpit's soft-focus, which is exactly the difference between
# "a screen" and "a hologram". The wash carries the theme's own navy at high
# alpha, so a card reads as a plate with a hint of what is under it — image
# 9's cards are legible over the grid, not floating in it.
#
# Depth is one SHORT shadow. The cockpit runs 3.9u..6.4u; this runs
# 1.4u..2.4u with a 0.6u drop, which reads as a sheet lying on a screen
# rather than a pane hanging in air.

[elev.panel]
glass.rank    = 1                                              # the softest frost that still separates a card from the grid
glass.wash    = @surface.panel                                 # the navy plate's own colour at a 0.90 — nearly opaque
shadow.color  = @palette.black / 0.55
shadow.radius = 1.4u                                           # short: a sheet on a screen, not a pane in air
shadow.dy     = 0.6u

[elev.raised]
glass.rank    = 1
glass.wash    = @surface.raised
shadow.color  = @palette.black / 0.60
shadow.radius = 1.8u
shadow.dy     = 0.6u

[elev.focused]
glass.rank    = 1
glass.wash    = @surface.panel
corner        = chamfer                                        # the focused frame is CUT, not rounded — image 9's whole vocabulary is chamfered plate
radius        = @corner.sm
edge.color    = @accent.primary                                # full-strength cyan; this theme has no magenta gradient to spend on focus
edge.width    = @stroke.regular
shadow.color  = @palette.black / 0.60
shadow.radius = 2.0u
shadow.dy     = 0.6u

[elev.popover]
glass.rank    = 1
glass.wash    = @surface.raised / 0.96                         # NEARLY OPAQUE: a menu over a hex dump has to win outright
shadow.color  = @palette.black / 0.66
shadow.radius = 2.4u
shadow.dy     = 0.8u

[elev.fixture]
glass.rank    = 1
glass.wash    = @surface.base / 0.94                           # the full-screen sheet; same reasoning as the popover


# ---------------------------------------------------------------- glow
# Half a cockpit's worth, and only on the three things image 9 actually
# blooms: the pane outline, the active taskbar item, and the donut arcs. The
# clock is large enough to carry itself and the hex dump must NOT glow — it
# is contrast-exempt decoration and a glow would promote it to information.
[glow]
panel_edge.enabled     = true
panel_edge.radius      = 0.7u                                  # a tight rim, resolved as a shell rather than a sprite
panel_edge.alpha       = 0.22
panel_edge.falloff     = linear                                # a flat screen's bloom has an edge; gauss is atmosphere
taskbar_active.enabled = true
taskbar_active.radius  = 0.9u
taskbar_active.alpha   = 0.28
gauge_arc.enabled      = true
gauge_arc.radius       = 0.8u
gauge_arc.alpha        = 0.25


# ---------------------------------------------------------------- decoration
# The plate is not blank. Image 9 shows a faint measuring grid across the
# whole background, sparse traces under it, and the hexadecimal dump columns
# down both outer margins labelled BAZA DANYCH and STATUS.
[backdrop]
source = plate                                                 # the baked decoration plate IS the background here

[decor]
enabled = true

[decor.grid]
enabled     = true                                             # image 9's measuring grid — the layer the master names for this theme by number
spacing     = 4.4u
alpha       = 0.06
major_every = 4
major_alpha = 0.11

[decor.traces]
enabled = true                                                 # under the grid, sparser than image 4's: texture, never pattern
density = 0.10
alpha   = 0.07
color   = @accent.primary
seed    = 9

[decor.dump]
enabled = true                                                 # the hexadecimal margins, image 9's single most characteristic feature

[ornament.dump]
source      = random                                           # off in the master; a theme turns it on, so the layout never has to change to change the look
seed        = 9
col_cells   = 11                                               # taller columns than the master's 9: image 9's margins run the full pane height
refresh_hz  = 1.5hz                                            # slower than the master's 2.0: shimmer, not flicker, beside real readouts
# color and alpha are NOT set. text.instrument at 1.78:1 is contrast-exempt
# precisely because this block carries no information, and 5.20 forbids
# rendering it in any other role.

# No vignette, no starfield, no ribbons. Image 9 is a flat lit screen with
# even corners; a vignette would say "lens", and this theme is not a camera.


# ---------------------------------------------------------------- deck
# "The most elaborate taskbar in the set": large bordered buttons, each a
# glyph above a caption, flanked by < > paging chevrons and two donut gauges,
# spread across the full width.
[dock]
h                = 14u                                         # taller than @size.2xl: these are two-line buttons, not icons
item_w           = 13u
align            = justify                                     # image 8 centres its four icons; image 9 justifies a full row
caption_gap      = 0.5u
border           = @stroke.thin                                # every button is visibly bordered, unlike image 7's bare chevron bar
active_indicator = border

# ---------------------------------------------------------------- shape
# Image 9's whole vocabulary is a chamfered plate: tight cuts and hairlines,
# because the deck is dense and a soft corner would eat the little space
# between two readouts. These two are GLOBAL — every frame the interface
# draws follows them, which is what makes this theme read as a different
# machine rather than the same one repainted.

[corner]
md = 0.6u                # tighter than the master's 1.2u: a plate, not a card

[border.edge]
width = @stroke.hair     # the deck is drawn in hairlines throughout
