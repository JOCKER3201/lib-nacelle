[meta]
schema          = 1
name            = "Pure"
name[pl]        = "Czysta"
description     = "One saturated green does everything. Reference image 3."
description[pl] = "Jedna nasycona zieleń robi wszystko. Obraz referencyjny 3."
author          = "nacelle"
family          = console
base            = "default"
strict          = false
watch           = false


# #########################################################################
# PURE — reference image 3, "pure green console".
#
# This is the most terminal-like of the six console images: ONE bright
# saturated green (#33DD44) draws every border, title, glyph, hexagon,
# chart line, icon and clock, and there is essentially no secondary hue on
# the screen at all. What every other theme says with a second colour, this
# one says with BRIGHTNESS — image 3's crew badges read `CRITICAL` in bright
# green beside `CONTAINED` in a dimmer green, which is what the
# `mono_plus_warning` severity mode with three pinned greens encodes (full
# `mono` is arithmetically impossible for seven roles — m3 M6). Everything
# below is either a seed or a consequence of having exactly one hue to spend.
#
# What is NOT here is as much of the theme as what is. The greyscale station
# hull with a green rim light, the dim CONTAINED chrome, the black field with
# no PCB traces and no vignette, the solid-green keyboard bloom's absence
# from the UI — all of that is already what `default` derives from one
# accent, so none of it is written twice.
# #########################################################################


# ---------------------------------------------------------------- palette
# The seeds. Everything else in the ~2 190-token catalogue derives from
# these six lines, which is why this file is thirty lines long and not five
# hundred (5.2).
[palette]
black      = #030603
                    # shade() target: severity badge fills, vignette, scrim.
                    # NOT the bed — the surface ladder never consulted this
                    # seed (m3 §2.1); the bed is surface.lift/chroma below.
                    # Image 3 is a bright green on GENUINE black. Literal by
                    # rule
white      = #E9F7E8
                    # tint() target. The master's mint-tinted white carries a
                    # hue this theme does not own; this one is the same
                    # lightness on the accent's own hue. Literal by rule
accent     = #33DD44
                    # THE colour: every border, title, glyph, hexagon, chart
                    # line, icon, the clock and the render's rim light
accent_alt = @palette.accent
                    # NO SECOND HUE. The master derives accent_alt as
                    # hue(accent, 32), which for this seed lands on the teal
                    # #00D7B6 — a colour image 3 does not contain. Pointing it
                    # back at the accent makes accent.secondary identical to
                    # accent.primary, and the second-hue slots (symlink
                    # glyphs, secondary chrome) fall back onto the one hue.
                    # This is the single line that makes "no secondary hue at
                    # all" true rather than nearly true
neutral    = #6B726B
                    # hue-free grey anchor for offline / disabled. The
                    # master's #6B7A74 sits at hue 170; this is the same
                    # lightness and chroma on the accent's 144, so even the
                    # grey belongs to the theme. Literal by rule


# ---------------------------------------------------------------- surface
# THE correction (m3 §4.3). "One bright saturated green sitting on genuine
# black." The shipped composited panel was #141F13, a dark olive at L 0.224
# — image 1's number, not image 3's.
[surface]
lift   = -0.062
                    # composited panel #141F13 -> #0B0F0A, L 0.163. Void goes
                    # #020602 -> #000100, which is also the terminal bed, and
                    # image 3 is the most terminal-like of the six
chroma = 0.45
                    # image 3's black is BLACK, not green-black. The master's
                    # C 0.0285 at panel is a green cast this image does not
                    # have; 0.45x drops it to 0.0124


# ---------------------------------------------------------------- text
[text]
chroma = 1.8
                    # text.title #9EEB9D -> #3EE24B. The image's own value is
                    # #33DD44; this is dE 0.016 from it. The pastel was the
                    # reason "one green does everything" did not read
lift   = -0.07
                    # with the bed at L 0.163 the whole ladder can come down
                    # and gain chroma
primary = #7CE07F
                    # PINNED. text.primary has 35 consumers and is the value
                    # half of every readout plus the terminal's default
                    # foreground. The ladder's lowest chroma coefficient
                    # (0.15) keeps it near-white even at chroma 1.8 (#B1D4AF);
                    # image 3 has no near-white on it. 11.80:1 on the panel


# ---------------------------------------------------------------- border
# Image 3's edge is the loudest expression of its one green; with the bed
# dropped to genuine black the ring can go nearly solid. 9.18:1 on the
# composited panel (m3 §5.2).
[border]
default = alpha(@accent.primary, 0.85)


# ---------------------------------------------------------------- severity
# THE POINT OF THIS THEME. Image 3 encodes CRITICAL/CONTAINED by brightness
# alone, and that works for the three roles a badge shows at once. Seven
# roles on one hue would need 0.69 of OKLab L and the readable band on a
# near-black bed is ~0.40 — `mono` cannot meet the engine's own 0.115 floor
# for the full row (m3 M6), so the mode is `mono_plus_warning` with the
# three badge greens pinned, which is what image 3 actually shows.
[severity]
mode   = mono_plus_warning
                    # NOT `mono` — arithmetically impossible for the full
                    # seven-role row (m3 M6). warning / info / unknown keep
                    # their canonical hues: they never share a badge row with
                    # the three greens below, they appear in the meters and
                    # the process table, and image 3's own ANSI argument
                    # applies — a monochrome UI is a style choice, a
                    # monochrome semantics is a lie
chroma = 0.92
                    # a touch under canonical. At 1.00 the mid-ladder roles
                    # sit at the accent's own full chroma and the badges start
                    # competing with the borders for attention; image 3's
                    # badges are quieter than its chrome
critical.text  = #6AF76F
                    # image 3: "CRITICAL bright green" — L 0.870; 13.94:1
contained.text = #35CC42
                    # image 3: "CONTAINED dimmer green" — L 0.740, dE 0.128
                    # from critical; 9.08:1
ok.text        = #009F21
                    # the third rung, L 0.610, dE 0.133 from contained; 5.50:1


# ---------------------------------------------------------------- terminal
# A monochrome UI is a style choice; a monochrome terminal palette breaks
# `ls`, `git diff` and `vim` (5.11). So the ANSI sixteen stay chromatic and
# the theme's identity comes from slots 0/7/8/15 — which already follow the
# accent — plus a hard pull on the six chromatic slots.
[term]
ansi.pull   = 0.34
                    # image 3 is the theme that should tint its terminal
                    # hardest, and 5.11 names 34 % as image 3's figure. Safe
                    # now that the master's ansi.drift_clamp gives the
                    # generator a 6deg hard cap (m3 M6): slot 1 lands on
                    # #D54C29, still unambiguously red, which the shipped
                    # file needed three drift caps to achieve — those three
                    # ansi.drift.* lines are DELETED, the clamp subsumes them
ansi.chroma = 0.92
                    # the same restraint the severity ladder takes, for the
                    # same reason — 5.11 names 0.92 for image 3


# ---------------------------------------------------------------- ornaments
[ornament.hex]
fill_to = @ornament.hex.fill
                    # "Hexagons are solid filled, not gradient." The master
                    # ramps a cell from alpha 0.85 down to 0.15 for image 1's
                    # gradient hexagons; collapsing the far stop onto the near
                    # one gives image 3's flat cells. default.theme names this
                    # exact edit on the fill_to line


# ---------------------------------------------------------------- imagery
# Image 3's `LIVE FEED: SECURITY B-16` — figures in a corridor — is
# explicitly "desaturated toward green". This is the one theme that grades
# its own photographic feed, and it stays inside the ceilings 5.26 sets
# (tint_strength <= 0.35, saturation >= 0.35) because a theme may tint
# evidence a little and a mood may not tint it at all.
[component]
image.photo.tint_strength = 0.30
                    # how far the photograph is pulled toward the tint; under
                    # the 0.35 ceiling, and enough that the feed belongs to
                    # the screen rather than sitting on it
image.photo.tint          = @accent.primary
                    # restated deliberately although it is already the master
                    # default: the strength above is meaningless without the
                    # hue beside it, and a reader should not have to open
                    # default.theme to learn which green the feed goes toward
image.photo.saturation    = 0.45
                    # how much of the photograph's own colour survives.
                    # Image 4 keeps 1.0 and its LIVE FEED stays naturally
                    # coloured; image 3 does the opposite, and 0.45 is the
                    # point where skin and corridor read as green-graded
                    # footage rather than as a green filter over a photo
