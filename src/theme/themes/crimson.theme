# =========================================================================
# CRIMSON — reference image 4, "crimson alert console" (family A).
#
# This is the red-alert state of the console: one hue, #FF2A35, doing
# every border, hexagon, glyph, chart line, icon and the big clock, on a
# near-black field carrying red PCB traces under a heavy vignette. It is
# the theme that proves the cascade in the hardest direction — nothing
# below re-colours a widget, it re-colours the SEED and lets ~2 190
# tokens follow. The two things image 4 does NOT let go red are the whole
# reason the file is longer than its palette: the `CONTAINED` badge stays
# amber, and the `LIVE FEED` thumbnail keeps natural photographic colour.
# =========================================================================

[meta]
schema          = 1
name            = "Crimson"
name[pl]        = "Karmazyn"
description     = "Red alert console: everything red, amber CONTAINED. Reference image 4."
description[pl] = "Konsola czerwonego alarmu: wszystko na czerwono, bursztynowe CONTAINED. Obraz referencyjny 4."
author          = "nacelle"
family          = console
base            = "default"


# =========================================================================
# palette — the seeds. THIS IS THE THEME.
# Four literals; `accent_alt` and `data` are deliberately left derived.
# `data` defaults to `@palette.accent` (5.2), and that single inherited
# line is what sends the ANALYTICS FEED line chart, the station wireframe,
# the orbits and every plot red along with the chrome — image 4's "EVERY
# chart, glyph, border and badge follows, without any per-widget editing".
# Separating the two is one line, and it is `lockdown`'s, not this file's.
# =========================================================================
[palette]
accent  = #FF2A35   # image 4's alert red: borders, hexagons, icons, the clock, the charts
black   = #060305   # shade() target; must be a literal (5.2). CORRECTED from #08060B (m3 §4.4):
                    # that value is hue 305 — a violet-black, which tints every severity badge
                    # pill and the vignette floor away from the screen. Image 4's field is
                    # neutral black under red traces
white   = #FFEDEB   # tint() target; must be a literal (5.2). Warm white so highlights stay inside the hue
neutral = #74707E   # hue-free grey for offline / disabled. Pulled a hair COOL on purpose:
                    # a warm grey next to this accent reads as a dimmed alarm rather than as "no signal"


# =========================================================================
# surface — THE correction (m3 §4.4). Image 4: "Background is BLACK with
# red PCB traces and a heavy vignette." The shipped composited panel was
# #271615 — a warm brown covering most of the screen.
# =========================================================================
[surface]
lift = -0.065       # composited panel #271615 -> #180807, and the void (terminal bed,
                    # swapchain clear) #0A0303 -> #020000


# =========================================================================
# text — "everything red: borders, hexagons, the ANALYTICS FEED line chart,
# icons, clock".
# =========================================================================
[text]
chroma = 1.4        # at 1.0 the ladder is a pink-white; 1.4 keeps the readouts inside the
                    # hue without touching their lightness, so the AAA floor is unmoved


# =========================================================================
# border — a saturated red on a near-black bed cannot go much higher than
# 4.60:1 without leaving the hue image 4 states; 0.85 is chosen knowingly
# (m3 §5.2: the tightest number in the deliverable — raising it past 0.85
# buys 0.6 of ratio and costs the "black screen with a red line on it" the
# image is). The edge carries no text; 4.60 clears the 4.5 floor that would
# apply if it did.
# =========================================================================
[border]
default = alpha(@accent.primary, 0.85)


# =========================================================================
# severity — the one place image 4 refuses the monochrome.
# Mode stays `hue` (the master default): the canonical severity hues pulled
# 0.20 toward the accent and clamped to 7deg. `critical` is NOT pinned:
# after the master's 7deg clamp (m3 M6) it derives to #FF544D, a red that
# belongs to this screen. Two roles are pinned because the image names
# them, and an explicit per-role value always wins over the mode (5.10) —
# the "explicit severity override survives a monochrome palette" this theme
# exists to demonstrate.
# =========================================================================
[severity]
contained.text = #EFC24E   # image 4: AMBER `CONTAINED` badges standing beside red `CRITICAL` ones.
                           # The image's own value is ~#E8B33A, but that sits dE 0.096 from any
                           # warning that also clears critical, so the engine's repair pass moved
                           # one of them at load and the authored colour was not the shipped
                           # colour. #EFC24E is dE 0.039 from the measured amber (a lighter,
                           # yellower amber, still amber) and makes the whole trio stable (m3 §4.4)
warning.text   = #FF8A1E   # forced apart from both: dE 0.121 to critical, 0.126 to contained,
                           # 0.241 contained-to-critical. Nothing moves at load


# =========================================================================
# decor — the field behind the panels. Image 4: "Background is black with
# red PCB traces and a heavy vignette." Three switches; every parameter
# below them is already right in the master, and `decor.traces.color` is
# `@accent.primary`, so the traces went red the moment the seed did.
# =========================================================================
[decor]
enabled = true

[decor.traces]
enabled = true   # image 4's red PCB traces; cell, density, width, alpha and colour all inherited

[decor.vignette]
enabled = true   # the heavy corner falloff. The master's 0.55 on the overlay plate with a cos2
                 # curve IS image 4's measurement, so nothing here needs restating


# =========================================================================
# WHAT THIS THEME DELIBERATELY DOES NOT WRITE — recorded because a reader
# will look for these three and their absence is the point.
#
#   render.hull / render.rim — image 4's station is "grey with a red rim".
#   The master already resolves `hull = sat(@data.line, 0.0)` (grey) and
#   `rim = @accent.primary` (red). Writing them would restate the default.
#
#   component.image.photo.* — image 4's `LIVE FEED` thumbnail keeps its
#   natural photographic colour. The master ships `tint_strength = 0.0`
#   and `saturation = 1.0`, i.e. photographs are untouched unless a theme
#   asks; crimson does not ask. (`pure`, for image 3's green-graded feed,
#   is the theme that does.) The exception is honoured by silence.
#
#   term.* — a monochrome UI is a style choice, a monochrome terminal
#   palette breaks `ls`, `git diff` and `vim` (5.11). The generated ANSI
#   sixteen stay chromatic; the terminal's identity comes from the bed
#   (#020000, from surface.lift) rather than from a pull, which is the
#   honest answer for a red theme — a hard pull toward red walks ANSI green
#   to olive. With the master's 6deg drift clamp (m3 M6) slot 2 lands on
#   #6CBA3E, a real green; under the shipped master it was #8DB302, olive,
#   and `git diff` additions stopped reading as additions.
# =========================================================================
