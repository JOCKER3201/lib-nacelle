# =========================================================================
# lockdown — reference image 5 ("lockdown console", family A, two-hue).
#
# Image 5 is image 4's crimson alert console with one thing changed: the
# UI CHROME stays red — panel borders, titles, leader lines, MISSION LOGS,
# the SYSTEM LOCKDOWN button — while everything the console DRAWS turns
# blue: the station wireframe, the planet, the orbit lines, every plot.
# This is the theme that proves `data.*` is not `accent.*` (5.9), and it
# buys that separation with a single seed, `palette.data`. Everything
# below is the crimson palette plus that one line; the rest of the
# ~2 190-token catalogue is inherited from `default` as an EXPRESSION and
# re-derives itself in these hues.
#
# The specification writes this theme out as its worked example (3.4).
# This file is that example, checked against the master as it now stands:
# the four blocks 3.4 shows which the master has since made the default
# are named at the bottom rather than restated, because a key that
# resolves to the value it already had is a `--dump-theme` note (3.4).
# =========================================================================

[meta]
schema          = 1
name            = "Lockdown"
name[pl]        = "Blokada"
description     = "Red chrome, blue data. Reference image 5."
description[pl] = "Czerwony chrom, niebieskie dane. Obraz referencyjny 5."
author          = "nacelle"
family          = console
base            = "default"


# =========================================================================
# palette — the five seeds. THE ONLY AUTHORED IDENTITY OF THIS THEME.
#
# The whole interface falls out of these: surfaces at the fixed OKLab
# ladder in the accent hue, seven text roles, five borders, nine accents,
# twenty-eight severity members, the sixteen ANSI slots, ninety component
# colours. Measured for this seed after the m3 corrections: composited
# panel #180807 (L 0.160), text.primary #FFD4CF at 14.45 on it (floor
# 7.0), data.line #35A7FF at 7.54 (floor 3.0), term fg/bg 15.52 — none of
# them written.
# =========================================================================
[palette]
black   = #05060B    # shade() target and the vignette's floor. Colder than crimson's
                     # #060305 (m3 §4.5): image 5's field sits under a BLUE hologram.
white   = #FFEDEB    # tint() target. Warmed a hair off neutral so hover highlights
                     # stay inside the red family instead of going pink-white.
accent  = #FF2A35    # THE CHROME. Borders, panel titles, glyphs, the launcher's
                     # SYSTEM LOCKDOWN button, leader lines, MISSION LOGS text.
data    = #35A7FF    # THE WHOLE POINT OF IMAGE 5, and it is one line. Plots,
                     # wireframes, the planet, orbit lines, gauge arcs, the eight
                     # categorical series — everything DRAWN rather than framed.
                     # 7.54:1 on the composited panel (floor 3.0).
neutral = #74707E    # hue-free anchor for offline / disabled. Default's #6B7A74 is
                     # green-tinted; in a red room that green reads as a live state.


# =========================================================================
# surface / text / border — crimson's corrections, unchanged (m3 §4.5):
# image 5's field is image 4's black, and its chrome is image 4's chrome.
# =========================================================================
[surface]
lift = -0.065        # composited panel -> #180807, void (terminal bed) -> #020000

[text]
chroma = 1.4         # keeps the readouts inside the red without touching lightness

[border]
default = alpha(@accent.primary, 0.85)
                     # 4.60:1 on the panel — the knowing tight number m3 §5.2 records
                     # for the red pair; past 0.85 buys 0.6 of ratio and costs the
                     # "black screen with a red line on it" the image is


# =========================================================================
# severity — two roles pinned; the other five derive.
#
# `mode = hue` is inherited: the canonical severity hues are dragged 0.20
# toward the accent and clamped at 7deg (m3 M6), which is how a red console
# still gets a green `(Zakonczone)` and a blue `POWIADOMIENIA`. Only the
# two roles image 4 and image 5 actually name on screen are written out —
# proof that derivation is a default-generator, not a lock (5.10).
# =========================================================================
[severity]
contained.text = #EFC24E   # image 4/5's AMBER `CONTAINED` badge standing beside a red
                           # `CRITICAL` one. The image's own ~#E8B33A sat dE 0.096 from
                           # any warning that also clears critical, so the load-time
                           # repair moved one of them and the authored colour was not
                           # the shipped colour. #EFC24E (dE 0.039 from the measured
                           # amber) makes the trio stable: nothing moves at load
warning.text   = #FF8A1E   # forced apart from both: dE 0.121 to critical, 0.126 to
                           # contained, 0.241 contained-to-critical. `critical` is NOT
                           # pinned — after the 7deg clamp it derives to #FF544D


# =========================================================================
# decoration — the field behind the panels.
#
# `default` ships every decorative layer off, so a silent theme renders
# flat and skips the passes (8). Image 5 is not silent: it shows red PCB
# traces on black and the heavy vignette that closes the console in.
# Both are baked plates, drawn once, not per frame.
# =========================================================================
[decor]
enabled = true             # the master switch; without it the two layers below are
                           # parsed and suppressed.

[decor.traces]
enabled = true             # image 5's PCB traces. `color` is already @accent.primary
                           # in the master, so they are red for free.
alpha   = 0.08             # one step below default's 0.10: image 5's traces sit under
                           # a heavier vignette than image 4's and read fainter for it.

[decor.vignette]
enabled = true             # image 5's corners are visibly closed down. `strength`
                           # 0.55, `layer` overlay and `color` @palette.black are
                           # already the master's values and are left alone.


# =========================================================================
# WHAT THIS THEME DELIBERATELY DOES NOT SAY, and why — because the four
# blocks a reader will look for are the four that are already correct.
#
# [render]  — 3.4 writes `hull = sat(@data.line, 0.0)` and
#             `rim = @accent.primary`. Both are now the master's defaults,
#             so image 5's grey hull with a red rim, blue wireframe and
#             blue orbits arrives with nothing written: render.wire,
#             .orbit, .planet and .silhouette all track @data.line, and
#             only the rim reaches for the chrome.
#
# [mood.*]  — `alert` and `lockdown` are both declared in the master, and
#             `mood.lockdown` (inherit = "alert", wash #FF2A35 / 0.22,
#             thicker frames, vignette on) is already this theme's own
#             identity as a transient state. Its `palette.data = #35A7FF`
#             is a no-op here, which is the correct relationship: what
#             crimson has to switch to, lockdown simply is.
#
# icon.lock — the SYSTEM LOCKDOWN button's padlock, U+E20C at
#             @icon.color -> @accent.primary. Already red. Image 5 draws
#             that button larger and brighter than its neighbours; size
#             and prominence in a launcher row are the host's call, not a
#             colour token's.
#
# chart.*   — every plot token forwards to data.*, so the ANALYTICS FEED
#             line, its fill, grid, axis and all eight categorical series
#             turn blue from `palette.data` alone. Fifty component
#             overrides here would be fighting the derivation.
#
# accent_alt — left at hue(@palette.accent, 32). Image 5 shows no second
#             chrome hue; the blue in it is data, and data has its seed.
# =========================================================================
